#!/bin/sh
# A reference launcher for Pi's own terminal UI (interactive `pi`) as an OpenRig community harness. Copy it, own it, and
# change it: OpenRig doesn't ship or run it. It's written for Pi 1.4.0 from its source and not yet checked with a real Pi.
# It follows docs/reference/community-harness-presets.md (`names_conversation`, `first_input`):
#   - a new launch (OPENRIG_CONVERSATION set): Pi creates the session whose id is that name, in the seat's own session
#     folder, and takes the first input as its first prompt;
#   - a resume (OPENRIG_RESUME_REF set): the launcher opens the one session file whose id is that name, and starts nothing
#     when there isn't exactly one. Pi's --session-id creates a new session for an id it doesn't find, and --session with
#     an id can open another session whose id starts the same way, so neither is used to resume.
# It also keeps Pi's chat screen up, so a seat never falls back to a bare shell:
#   - OPENRIG_MODEL (the seat's model) becomes --model, and OPENRIG_EFFORT becomes --thinking when it is one of Pi's
#     levels (off, minimal, low, medium, high, xhigh, max); any other effort is named on stderr and Pi starts without one;
#   - OPENRIG_PI_APPEND_SYSTEM_PROMPT (an absolute path to a readable file) becomes --append-system-prompt on EVERY start,
#     a relaunch and a resume included, so a seat's role survives compaction. A path that is not a readable file is refused
#     by name and nothing starts, since Pi would read it as the prompt text;
#   - --no-approve is always passed, so Pi doesn't stop at its "trust this project folder?" dialog;
#   - when Pi exits it is started again, on the same session (the one file with that id, else the same id again), after a
#     back-off that doubles from 2 s to 60 s. Quick exits are counted; a start that ran for 60 s resets the count; more than
#     5 in a row and the launcher gives up, says so on stderr and exits 1. The first input goes to the first start only.
#     OPENRIG_PI_RELAUNCH=0 runs Pi once instead, in this process. OPENRIG_PI_MAX_RESTARTS, OPENRIG_PI_STABLE_SECS and
#     OPENRIG_PI_BACKOFF_SECS change the numbers; OPENRIG_PI_SLEEP replaces `sleep` (for tests);
#   - in a terminal the loop turns on job control, so Pi, not this script, is the pane's foreground process. Without it tmux
#     reports `sh` while Pi runs, and OpenRig reads the seat as sitting at a shell.
set -eu

pi="${OPENRIG_PI:-pi}"

# The seat's model and thinking level. A model that starts with "-" would be read by Pi as a flag.
model="${OPENRIG_MODEL:-}"
case "$model" in
  -*) echo "openrig-pi-tui-launch: OPENRIG_MODEL '$model' would read as a Pi flag; starting nothing" >&2; exit 2 ;;
esac
# The seat's role and its standing notes, as a system-prompt file Pi appends on EVERY start (a relaunch and a resume too), so
# they outlive compaction. Pi reads the value as the text itself when it is not a file, so a path that is not a readable
# regular file would silently become the prompt: refuse it by name. An absolute path, and none that would read as a flag.
append_prompt="${OPENRIG_PI_APPEND_SYSTEM_PROMPT:-}"
if [ -n "$append_prompt" ]; then
  case "$append_prompt" in
    -*) echo "openrig-pi-tui-launch: OPENRIG_PI_APPEND_SYSTEM_PROMPT '$append_prompt' would read as a Pi flag; starting nothing" >&2; exit 2 ;;
    /*) ;;
    *) echo "openrig-pi-tui-launch: OPENRIG_PI_APPEND_SYSTEM_PROMPT '$append_prompt' isn't an absolute path; starting nothing" >&2; exit 2 ;;
  esac
  if [ ! -f "$append_prompt" ]; then
    echo "openrig-pi-tui-launch: OPENRIG_PI_APPEND_SYSTEM_PROMPT '$append_prompt' isn't a file; starting nothing" >&2; exit 2
  fi
  if [ ! -r "$append_prompt" ]; then
    echo "openrig-pi-tui-launch: OPENRIG_PI_APPEND_SYSTEM_PROMPT '$append_prompt' isn't readable; starting nothing" >&2; exit 2
  fi
fi
thinking=""
if [ -n "${OPENRIG_EFFORT:-}" ]; then
  case "$OPENRIG_EFFORT" in
    off|minimal|low|medium|high|xhigh|max) thinking="$OPENRIG_EFFORT" ;;
    *) echo "openrig-pi-tui-launch: effort '$OPENRIG_EFFORT' is not a Pi thinking level (off, minimal, low, medium, high, xhigh, max); starting Pi without --thinking" >&2 ;;
  esac
fi

state="${OPENRIG_HOME:-$HOME/.openrig}/state/pi-tui/${OPENRIG_NODE_ID:-${OPENRIG_SESSION_NAME:-default}}"
sessions="$state/sessions"

# Each seat gets its own Pi agent folder (settings, logins, skills) unless PI_CODING_AGENT_DIR is already set, so seats
# don't share settings and a person's ~/.pi/agent isn't touched. Give the seat its provider key in its environment, or its
# login and settings in this folder, before its first start.
PI_CODING_AGENT_DIR="${PI_CODING_AGENT_DIR:-$state/agent}"
# Pi expands a leading ~ in this folder; do the same, so the skills land where Pi looks.
case "$PI_CODING_AGENT_DIR" in
  "~") PI_CODING_AGENT_DIR="$HOME" ;;
  "~/"*) PI_CODING_AGENT_DIR="$HOME/${PI_CODING_AGENT_DIR#"~/"}" ;;
esac
export PI_CODING_AGENT_DIR
mkdir -p "$PI_CODING_AGENT_DIR/skills" "$sessions"

# Copy the installed OpenRig's coordination skills in at each launch, so an upgrade reaches the seat. Pi lists the skills
# in <agent folder>/skills/ by itself; the seat's first input should still name queue-handoff (see the recipe).
skills_from="${OPENRIG_PI_SKILLS_FROM:-${OPENRIG_HOME:-$HOME/.openrig}/plugins/openrig-core/skills}"
set -f
for skill in ${OPENRIG_PI_SKILLS:-queue-handoff}; do
  case "$skill" in
    *[!a-z0-9-]*|-*) echo "openrig-pi-tui-launch: skipping '$skill': not a skill name" >&2; continue ;;
  esac
  if [ -d "$skills_from/$skill" ]; then
    rm -rf "$PI_CODING_AGENT_DIR/skills/$skill"
    cp -Rp "$skills_from/$skill" "$PI_CODING_AGENT_DIR/skills/"
  else
    echo "openrig-pi-tui-launch: no $skill skill in $skills_from; starting without it" >&2
  fi
done
set +f

# Pi's session ids: letters, digits, '.', '_' and '-', starting and ending with a letter or digit.
valid_id() {
  case "$1" in
    "" | *[!A-Za-z0-9._-]* | [!A-Za-z0-9]* | *[!A-Za-z0-9]) return 1 ;;
  esac
}

# The first input goes over as Pi's first prompt, byte for byte, after `--`. OpenRig's starts with its identity-context
# line; Pi would read one starting with @ as a file even after `--`, and may run one starting with / as a command.
first_input=""
if [ -n "${OPENRIG_FIRST_INPUT:-}" ]; then
  first_input=$(cat "$OPENRIG_FIRST_INPUT" && printf '.')
  first_input="${first_input%.}"
fi

# Pi names a session file <time>_<id>.jsonl, but the file's first line, its header, is what says which session it is:
# its top-level type and id, read as JSON as Pi reads it. Pi writes the file only once the conversation has a message, so
# a session that never got one can't be reopened. Pi runs on Node, so node reads the header. Sets `found` and `count`;
# a missing node sets count to -1.
node="${OPENRIG_PI_NODE:-node}"
find_session() {
  found="" count=0
  if ! command -v "$node" >/dev/null 2>&1; then count=-1; return 0; fi
  for file in "$sessions"/*_"$1".jsonl; do
    [ -s "$file" ] || continue
    if head -n 1 "$file" | "$node" -e '
      let text = ""; process.stdin.on("data", c => { text += c; }).on("end", () => {
        try { const h = JSON.parse(text); process.exit(h && h.type === "session" && h.id === process.argv[1] ? 0 : 1); }
        catch { process.exit(1); }
      });' "$1"; then
      found="$file" count=$((count + 1))
    fi
  done
}

# One start of Pi. $1 and $2: the session flag and its value. $3: 1 to hand over the first input. $4: "exec" to replace
# this process with Pi, so that Pi's own exit status is this launcher's.
run_pi() {
  start_mode="$4" start_first="$3"
  set -- --session-dir "$sessions" "$1" "$2"
  if [ -n "$model" ]; then set -- "$@" --model "$model"; fi
  if [ -n "$thinking" ]; then set -- "$@" --thinking "$thinking"; fi
  if [ -n "$append_prompt" ]; then set -- "$@" --append-system-prompt "$append_prompt"; fi
  set -- "$@" --no-approve
  if [ "$start_first" = 1 ] && [ -n "$first_input" ]; then set -- "$@" -- "$first_input"; fi
  if [ "$start_mode" = exec ]; then exec "$pi" "$@"; fi
  "$pi" "$@"
}

if [ -n "${OPENRIG_RESUME_REF:-}" ]; then
  name="$OPENRIG_RESUME_REF"
  if ! valid_id "$name"; then
    echo "openrig-pi-tui-launch: '$name' isn't a Pi session id; starting nothing" >&2
    exit 2
  fi
  find_session "$name"
  if [ "$count" -eq -1 ]; then
    echo "openrig-pi-tui-launch: $node isn't on PATH to read Pi's session headers; starting nothing" >&2
    exit 1
  fi
  if [ "$count" -ne 1 ]; then
    echo "openrig-pi-tui-launch: expected one Pi session $name in $sessions, found $count; starting nothing" >&2
    exit 1
  fi
  flag="--session" value="$found"
elif [ -n "${OPENRIG_CONVERSATION:-}" ]; then
  name="$OPENRIG_CONVERSATION"
  if ! valid_id "$name"; then
    echo "openrig-pi-tui-launch: '$name' isn't a Pi session id; starting nothing" >&2
    exit 2
  fi
  flag="--session-id" value="$name"
else
  echo "openrig-pi-tui-launch: OpenRig passed no conversation name; is names_conversation set in the preset?" >&2
  exit 2
fi

if [ "${OPENRIG_PI_RELAUNCH:-1}" = 0 ]; then
  run_pi "$flag" "$value" 1 exec
fi

# Keep Pi up. In a terminal, job control makes Pi the pane's foreground process group (see the header).
if [ -t 0 ]; then set -m; fi
max="${OPENRIG_PI_MAX_RESTARTS:-5}"
stable="${OPENRIG_PI_STABLE_SECS:-60}"
base="${OPENRIG_PI_BACKOFF_SECS:-2}"
pause="${OPENRIG_PI_SLEEP:-sleep}"
delay="$base" quick=0 starts=0 with_first=1
while :; do
  began=$(date +%s)
  status=0
  run_pi "$flag" "$value" "$with_first" run || status=$?
  starts=$((starts + 1)) with_first=0
  if [ $(($(date +%s) - began)) -ge "$stable" ]; then quick=0 delay="$base"; else quick=$((quick + 1)); fi
  if [ "$quick" -gt "$max" ]; then
    echo "openrig-pi-tui-launch: pi stopped $quick times in a row within ${stable}s of starting (last status $status; $starts starts in all); giving up" >&2
    exit 1
  fi
  # The next start is on the same session: the one file with this id, else the same id again.
  find_session "$name"
  if [ "$count" -eq -1 ]; then
    echo "openrig-pi-tui-launch: $node isn't on PATH to read Pi's session headers; giving up" >&2
    exit 1
  fi
  if [ "$count" -gt 1 ]; then
    echo "openrig-pi-tui-launch: found $count Pi sessions named $name in $sessions, not one; giving up" >&2
    exit 1
  fi
  if [ "$count" -eq 1 ]; then flag="--session" value="$found"; else flag="--session-id" value="$name"; fi
  echo "openrig-pi-tui-launch: pi exited (status $status); starting it again in ${delay}s" >&2
  "$pause" "$delay"
  delay=$((delay * 2))
  if [ "$delay" -gt 60 ]; then delay=60; fi
done
